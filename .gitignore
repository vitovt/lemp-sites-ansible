# Secrets: everything under secrets/ is private, except the docs and *.example templates.
/secrets/*
!/secrets/README.md
!/secrets/*.example

# Ansible runtime artefacts
*.retry
/collections/
/galaxy_roles/
/.ansible/

# Local Python virtualenv
/.venv/
__pycache__/

# Temporary SSH credentials and isolated test output.
/id_ed25519_codex*
/test-results/
/.pytest_cache/
