# Private server inventories are never tracked. Only the safe example is public.
/inventories/*/
!/inventories/example-server/
/inventories/example-server/secrets/*
!/inventories/example-server/secrets/*.example
!/inventories/example-server/secrets/cloudflare/
/inventories/example-server/secrets/cloudflare/*
!/inventories/example-server/secrets/cloudflare/*.example
# Keep any old controller secrets private during the transition.
/secrets/*

# Ansible runtime artefacts
*.retry
/collections/
/galaxy_roles/
/.ansible/

# Local Python virtualenv
/.venv/
__pycache__/

# Temporary SSH credentials and isolated test output.
/id_ed25519_codex*
/test-results/
/.pytest_cache/
