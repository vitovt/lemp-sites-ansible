#!/usr/bin/env python3
"""Manage a host_vars site list. Use --dry-run to inspect a change."""
import argparse
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

import yaml

ROOT = Path(__file__).resolve().parents[1]
sys.path[:0] = [str(ROOT / 'roles/site/files'), str(ROOT / 'library')]
from wp_hosting import DOMAIN, NAME, RESERVED


class UniqueLoader(yaml.SafeLoader):
    pass


def mapping(loader, node):
    result = {}
    for key_node, value_node in node.value:
        key = loader.construct_object(key_node)
        if key in result:
            raise ValueError('Duplicate YAML key: ' + str(key))
        result[key] = loader.construct_object(value_node)
    return result


UniqueLoader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, mapping)


def write(path, data):
    with tempfile.NamedTemporaryFile('w', dir=path.parent, delete=False) as temporary:
        yaml.safe_dump(data, temporary, sort_keys=False)
        name = temporary.name
    os.chmod(name, path.stat().st_mode & 0o777)
    os.replace(name, path)


def validate(domain, user, php, sites):
    if not DOMAIN.fullmatch(domain):
        raise ValueError('Invalid domain')
    if not NAME.fullmatch(user) or len(user) > 28 or user in RESERVED:
        raise ValueError('Invalid or reserved site user')
    if php not in ['8.3', '8.4', '8.5']:
        raise ValueError('Use a supported PHP branch: 8.3, 8.4, 8.5')
    for d, cfg in sites.items():
        cfg = cfg or {}
        if d == domain or domain in cfg.get('aliases', []):
            raise ValueError('Domain already exists')
        if user in (cfg.get('user', d.replace('.', '_').replace('-', '_')), cfg.get('db_name', d.replace('.', '_').replace('-', '_'))):
            raise ValueError('User or database already exists')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['add', 'info', 'remove', 'clone'])
    parser.add_argument('host')
    parser.add_argument('domain', nargs='?')
    parser.add_argument('extra', nargs='*')
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--install-wp', action='store_true')
    parser.add_argument('--yes', action='store_true')
    parser.add_argument('--activate', action='store_true')
    args = parser.parse_args()
    if not re.fullmatch('[a-zA-Z0-9_][a-zA-Z0-9_-]*', args.host):
        parser.error('Invalid inventory host')
    inventory = Path(os.environ.get('SITE_INVENTORY', 'inventories/prod'))
    inventory = (ROOT / inventory).resolve() if not inventory.is_absolute() else inventory.resolve()
    path = inventory / 'host_vars' / args.host / 'sites.yml'
    if path.resolve() != path or not path.is_file():
        parser.error('Unknown host_vars site list')
    data = yaml.load(path.read_text(), Loader=UniqueLoader)
    if not isinstance(data, dict) or not isinstance(data.get('wp_sites'), dict):
        raise ValueError('Require a wp_sites mapping')
    sites = data['wp_sites']
    if args.command == 'info':
        print(yaml.safe_dump(sites.get(args.domain) if args.domain else sites, sort_keys=False), end='')
        return 0
    if not args.domain or not DOMAIN.fullmatch(args.domain):
        parser.error('Specify a valid domain')

    def play(name, *extra):
        result = subprocess.run(['ansible-playbook', '-i', str(inventory), f'playbooks/{name}.yml', '--limit', args.host, *extra], cwd=ROOT)
        if result.returncode:
            raise RuntimeError('Deployment failed. The inventory records the requested site; fix the error and converge again.')

    if args.command != 'clone' and not args.yes and not args.dry_run:
        expected = args.domain if args.command == 'remove' else 'yes'
        if input(f'{args.command} {args.domain} on {args.host}. Type {expected}: ') != expected:
            parser.error('Aborted')
    if args.command in ('add', 'clone'):
        target = args.extra[0] if args.command == 'clone' and args.extra else args.domain
        if args.command == 'clone' and args.domain not in sites:
            parser.error('Unknown source site')
        if args.command == 'clone' and (not args.extra or args.domain == target):
            parser.error('clone <host> <source> <target> [user|-]')
        if args.command == 'clone' and not args.yes and not args.dry_run:
            if not DOMAIN.fullmatch(target):
                parser.error('Invalid target domain')
            prompt = f'Clone {args.domain} over {target} on {args.host}. Type {target}: '
            if input(prompt) != target:
                parser.error('Aborted')
        rest = args.extra[1:] if args.command == 'clone' else args.extra
        user = rest[0] if rest and rest[0] != '-' else target.replace('.', '_').replace('-', '_')
        php = rest[1] if len(rest) > 1 else str((sites.get(args.domain) or {}).get('php_version', '8.3'))
        if target not in sites:
            validate(target, user, php, sites)
            sites[target] = dict(user=user, db_name=user, php_version=php, wp_install=args.install_wp if args.command == 'add' else False,
                                 staging=args.command == 'clone' and not args.activate)
            print(yaml.safe_dump({target: sites[target]}, sort_keys=False), end='')
            if not args.dry_run:
                write(path, data)
                play('site', '-e', f'wp_site_only={target}')
        elif args.command == 'add':
            parser.error('Site already exists')
        if args.command == 'clone' and not args.dry_run:
            extra = ['-e', f'clone_from={args.domain}', '-e', f'clone_to={target}']
            extra += ['-e', f'confirm={target}']
            if args.activate:
                extra += ['-e', 'clone_activate=true']
            play('site-clone', *extra)
    elif args.command == 'remove':
        if args.domain not in sites:
            parser.error('Unknown site')
        if not args.dry_run:
            play('site-remove', '-e', f'wp_site_only={args.domain}', '-e', f'confirm={args.domain}')
            del sites[args.domain]
            write(path, data)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, RuntimeError, OSError, yaml.YAMLError) as exc:
        print('error: ' + str(exc), file=sys.stderr)
        sys.exit(1)
