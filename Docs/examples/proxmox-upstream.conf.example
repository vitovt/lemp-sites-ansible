# Include this inside the parent Nginx HTTPS server for the same site domain.
# The guest uses nginx_access_mode: direct and trusts the parent LAN source.
# Example guest setting: nginx_trusted_proxies: [192.0.2.1/32].
# Check that this is the parent's actual source address before use.
# The guest must have a trusted certificate for every forwarded host name.
# Validate Cloudflare source ranges on the parent before trusting its headers.
location / {
    # Preserve the requested host so the guest selects the correct site.
    proxy_set_header Host $host;
    # Replace visitor headers. Never pass a client-supplied value through.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Verify the guest certificate for this host name.
    proxy_ssl_server_name on;
    proxy_ssl_name $host;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    # Replace this documentation address with the guest's LAN IPv4 address.
    proxy_pass https://192.0.2.125;
}
