# {{ ansible_managed }}
# WordPress location rules. Adapted from Trellis (https://github.com/roots/trellis),
# MIT License, Copyright (c) Roots Software LLC.

# Hidden files (.git, .env, .htaccess), except ACME.
location ~ /\.(?!well-known/) {
    deny all;
}

# No PHP in uploads or other writable dirs.
location ~* ^/wp-content/(uploads|cache|upgrade)/.*\.(php[0-9]?|phtml|phar)$ {
    deny all;
}

# Files that must not be served.
location ~* /(wp-config\.php|readme\.html|license\.txt|wp-content/debug\.log)$ {
    deny all;
}
location ~* \.(sql|bak|old|orig|swp|log|ini|sh|tar|gz|zip)$ {
    deny all;
}

location = /favicon.ico { log_not_found off; access_log off; }
location = /robots.txt  { log_not_found off; access_log off; try_files $uri /index.php?$args; }

# Static assets.
location ~* \.(?:css|js|mjs|map|jpe?g|png|gif|webp|avif|ico|svg|woff2?|ttf|eot|mp4|webm)$ {
    expires 30d;
    access_log off;
    try_files $uri =404;
}
