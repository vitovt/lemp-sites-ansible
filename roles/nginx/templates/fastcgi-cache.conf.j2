# {{ ansible_managed }}
# FastCGI cache zone for WordPress guests.
fastcgi_cache_path {{ nginx_fastcgi_cache_path }} levels=1:2 keys_zone=WORDPRESS:100m
                   max_size={{ nginx_fastcgi_cache_size }} inactive={{ nginx_fastcgi_cache_inactive }}
                   use_temp_path=off;
# Key format = Nginx Helper default; keep it, else purge misses entries.
fastcgi_cache_key "$scheme$request_method$host$request_uri";
fastcgi_cache_use_stale error timeout updating invalid_header http_500 http_503;
fastcgi_cache_lock on;
# Respect Cache-Control, Expires and Set-Cookie from PHP.
