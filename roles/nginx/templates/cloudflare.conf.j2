# {{ ansible_managed }}
# Real visitor IP from Cloudflare + origin allow-list.

{% for net in (nginx_trusted_proxies if nginx_access_mode == 'proxy' else nginx_cf_ranges) %}
set_real_ip_from {{ net }};
{% endfor %}
real_ip_header {{ nginx_real_ip_header }};
real_ip_recursive on;

# allow/deny would see the rewritten visitor IP (after realip) and block
# everyone. The geo below tests the TCP peer ($realip_remote_addr) instead.
# Vhosts: "if ($cf_origin_ok = 0) { return 444; }"
geo $realip_remote_addr $cf_origin_ok {
    default {{ '0' if nginx_cloudflare_only else '1' }};
    127.0.0.1/32 1;
    ::1/128 1;
{% for net in (nginx_trusted_proxies if nginx_access_mode == 'proxy' else nginx_cf_ranges) %}
    {{ net }} 1;
{% endfor %}
}

# Only a local root operation uses this uncached health request during maintenance.
geo $realip_remote_addr $wp_local {
    default 0;
    127.0.0.1/32 1;
    ::1/128 1;
}
map "$wp_local:$http_x_wp_health" $wp_internal_health {
    default 0;
    "1:1" 1;
}
