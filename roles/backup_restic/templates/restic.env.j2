# {{ ansible_managed }}
# Read by {{ backup_restic_bin }}. Manual use as root:
#   set -a; . {{ backup_restic_conf_dir }}/env; set +a; restic snapshots
RESTIC_REPOSITORY={{ backup_restic_repo }}
RESTIC_PASSWORD_FILE={{ backup_restic_conf_dir }}/password
RESTIC_CACHE_DIR=/var/cache/restic
BACKUP_PATHS="{{ backup_restic_paths | join(' ') }}"
BACKUP_EXCLUDES="{{ backup_restic_excludes | join(' ') }}"
KEEP_DAILY={{ backup_restic_keep_daily }}
KEEP_WEEKLY={{ backup_restic_keep_weekly }}
KEEP_MONTHLY={{ backup_restic_keep_monthly }}
BACKUP_MOUNT={{ backup_restic_mount }}
BACKUP_REQUIRE_MOUNT={{ backup_restic_require_mount | bool | lower }}
{% if backup_restic_copy_repo | default('') %}
RESTIC_COPY_REPOSITORY={{ backup_restic_copy_repo }}
RESTIC_COPY_PASSWORD_FILE={{ backup_restic_copy_password_file }}
{% endif %}
REMOVED_DIR={{ backup_restic_removed_dir }}
RECOVERY_KEEP_DAYS={{ backup_restic_recovery_days | default(14) }}
