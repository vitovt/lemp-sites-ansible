# {{ ansible_managed }}
{{ site_cfg.path }}/logs/*.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    su {{ site_cfg.user }} {{ site_cfg.user }}
    sharedscripts
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
