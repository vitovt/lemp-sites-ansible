# {{ ansible_managed }}
# Site facts for root tools (wp-backup, wp-monitor, site-remove/clone).
# Shell syntax, no secrets.
DOMAIN={{ site_cfg.domain }}
SITE_USER={{ site_cfg.user }}
DB_NAME={{ site_cfg.db_name }}
PHP_VERSION={{ site_cfg.php_version }}
ALIASES="{{ site_cfg.aliases | join(' ') }}"
CACHE={{ site_cfg.cache | bool | lower }}
REDIS={{ site_cfg.redis | bool | lower }}
