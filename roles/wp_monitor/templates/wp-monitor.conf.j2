# {{ ansible_managed }}
STATE_DIR={{ wp_monitor_state_dir }}
WPCLI={{ wp_monitor_wpcli }}
CHECKS="{{ wp_monitor_checks | join(' ') }}"
WRITABLE_DIRS="{{ site_writable_dirs | default(['wp-content/uploads', 'wp-content/cache', 'wp-content/upgrade']) | join(' ') }}"
CERT_MIN_DAYS={{ wp_monitor_cert_min_days | int }}
DISK_MIN_FREE_PCT={{ wp_monitor_disk_min_free_pct | int }}
DROPINS='{{ wp_monitor_dropins | map('replace', '.', '\\.') | join('\|') }}'
CONTENT_EXCLUDE_TYPES="{{ wp_monitor_content_exclude_types | join(' ') }}"
CONTENT_ATTACHMENTS={{ 'yes' if wp_monitor_content_attachments | bool else 'no' }}
