#!/usr/bin/env python3
"""Write a local alert and send bounded messages to Telegram. Return failure on lost delivery."""
import json
import os
from pathlib import Path
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request


def chunks(text, size=3500):
    # Limit UTF-16 units as well as Unicode characters. Telegram counts entities this way.
    chunk = ''
    units = 0
    for char in text:
        cost = 2 if ord(char) > 0xffff else 1
        if units + cost > size:
            yield chunk
            chunk, units = '', 0
        chunk += char
        units += cost
    if chunk:
        yield chunk


def main():
    text = ' '.join(sys.argv[1:]) if len(sys.argv) > 1 else sys.stdin.read()
    if not text.strip():
        return 0
    text = f'[{os.uname().nodename}] {text}'
    subprocess.run(['logger', '-t', 'tg-alert', '-p', 'user.warning'], input=text, text=True, check=False)
    path = Path(os.environ.get('TG_ALERT_ENV', '/etc/tg-alert.env'))
    if not path.exists():
        return 1
    values = {}
    for line in path.read_text().splitlines():
        if '=' in line and not line.startswith('#'):
            key, value = line.split('=', 1)
            values[key] = value.strip().strip("'\"")
    token, chat = values.get('TG_BOT_TOKEN'), values.get('TG_CHAT_ID')
    if not token or not chat:
        return 1
    try:
        for chunk in chunks(text):
            data = urllib.parse.urlencode({'chat_id': chat, 'text': chunk, 'disable_web_page_preview': 'true'}).encode()
            request = urllib.request.Request(f'https://api.telegram.org/bot{token}/sendMessage', data=data)
            with urllib.request.urlopen(request, timeout=20) as response:
                if not json.load(response).get('ok'):
                    return 1
    except (OSError, ValueError, urllib.error.URLError):
        # Never log the URL, which contains the bot token.
        subprocess.run(['logger', '-t', 'tg-alert', '-p', 'user.err', 'Telegram delivery failed'], check=False)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
