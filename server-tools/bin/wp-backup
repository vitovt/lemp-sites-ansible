#!/usr/bin/env python3
"""Back up, verify, stage and restore managed WordPress data."""
import argparse
import gzip
import hashlib
import json
import os
from pathlib import Path
import shlex
import shutil
import re
import signal
import sys
import tempfile
import time

sys.path.insert(0, '/usr/local/lib/wp-hosting/lib')
from cli_diagnostics import hint, HintParser
from wp_hosting import (Database, SITES, backup_site, clone, load, operation_lock, prefix,
    read_env, require_wordpress_tables, restore_database, remove_site, sha256_file, run, site)


BACKUP_MARKERS = Path('/var/lib/wp-hosting/backups')

def snapshot_for(domain, env):
    snapshots = json.loads(run(['restic', 'snapshots', '--json', '--tag', 'complete'], env=env).stdout)
    candidates = [s for s in snapshots if any(p in (str(SITES), str(SITES / domain)) for p in s['paths'])]
    if not candidates:
        raise ValueError('No complete snapshot for ' + domain)
    return max(candidates, key=lambda s: s['time'])['id']


def prune_recovery(sites, days=14):
    if days < 1:
        raise ValueError('Recovery retention must be at least one day')
    cutoff = time.time() - days * 86400
    for s in sites:
        for path in (s['base'] / 'backup').iterdir():
            if not re.fullmatch(r'(clone|update)-[0-9]+|db-before-restore-[0-9]+[.]sql[.]gz', path.name):
                continue
            if path.is_symlink() or path.stat().st_uid != os.geteuid() or path.stat().st_mtime >= cutoff:
                continue
            if path.is_dir():
                shutil.rmtree(path)
            else:
                path.unlink()


def backup(sites, env, db, full=False):
    for s in sites:
        print('Prepare SQL dump and manifests: ' + s['domain'], flush=True)
        backup_site(s, db)
    paths = shlex.split(env['BACKUP_PATHS']) if full else [str(sites[0]['base'])]
    if not paths or any(not Path(p).exists() for p in paths):
        raise ValueError('A configured backup path is missing')
    tag = 'run-' + str(time.time_ns())
    args = ['restic', 'backup', '--quiet', '--tag', tag, '--tag', 'nightly' if full else 'manual']
    if not full:
        args += ['--tag', 'site:' + sites[0]['domain']]
    for exclude in shlex.split(env['BACKUP_EXCLUDES']):
        args += ['--exclude', exclude]
    print('Create restic snapshot', flush=True)
    result = run(args + paths, env=env, check=False, timeout=7200)
    if result.returncode:
        # A partial snapshot never receives the complete tag. Keep good retention points.
        raise RuntimeError('Restic backup is incomplete or failed (exit ' + str(result.returncode) + ')')
    snapshots = json.loads(run(['restic', 'snapshots', '--json', '--tag', tag], env=env).stdout)
    if len(snapshots) != 1:
        raise RuntimeError('Cannot identify the new snapshot')
    snapshot_id = snapshots[0]['id']
    if full:
        if env.get('RESTIC_COPY_REPOSITORY'):
            print('Copy snapshots to the configured destination', flush=True)
            run(['restic', '--repo', env['RESTIC_COPY_REPOSITORY'], '--password-file', env['RESTIC_COPY_PASSWORD_FILE'],
                 'copy', '--from-repo', env['RESTIC_REPOSITORY'], '--from-password-file', env['RESTIC_PASSWORD_FILE']], env=env, timeout=7200)
        print('Check restic repository', flush=True)
        run(['restic', 'check', '--quiet'], env=env, timeout=7200)
    run(['restic', 'tag', '--add', 'complete', snapshot_id], env=env)
    if full:
        run(['restic', 'forget', '--quiet', '--prune', '--tag', 'complete', '--keep-daily', env['KEEP_DAILY'],
             '--keep-weekly', env['KEEP_WEEKLY'], '--keep-monthly', env['KEEP_MONTHLY']], env=env, timeout=7200)
        prune_recovery(sites, int(env.get('RECOVERY_KEEP_DAYS', '14')))
    # Adding tags rewrites snapshot metadata and changes its content-addressed ID.
    # Resolve by this run's unique tag after all required steps have succeeded.
    completed = json.loads(run(['restic', 'snapshots', '--json', '--tag', tag], env=env).stdout)
    if len(completed) != 1 or 'complete' not in completed[0].get('tags', []):
        raise RuntimeError('Cannot identify the completed snapshot; no success marker was written')
    snapshot_id = completed[0]['id']
    # This root-owned marker is written only after required backup steps pass.
    from datetime import datetime
    now = datetime.now().astimezone()
    marker_dir = BACKUP_MARKERS
    marker_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    marker_dir.chmod(0o700)
    marker = marker_dir / (now.strftime('%Y%m%d-%H%M%S-') + snapshot_id + '.json')
    descriptor, temporary = tempfile.mkstemp(prefix='.backup-', dir=marker_dir)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, 'w') as stream:
            json.dump({'snapshot': snapshot_id, 'run_tag': tag, 'sites': [s['domain'] for s in sites],
                       'date': now.date().isoformat(), 'time': now.isoformat()}, stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, marker)
    finally:
        Path(temporary).unlink(missing_ok=True)
    print('PASS backup complete snapshot=' + snapshot_id)



def restore_files(s, env, snapshot=None, destination=None):
    snapshot = snapshot or snapshot_for(s['domain'], env)
    snapshots = json.loads(run(['restic', 'snapshots', '--json', snapshot], env=env).stdout)
    if len(snapshots) != 1 or 'complete' not in snapshots[0].get('tags', []):
        raise ValueError('Require a complete snapshot')
    if destination is None:
        root = Path('/srv/restore')
        root.mkdir(mode=0o700, exist_ok=True)
        root.chmod(0o700)
        destination = Path(tempfile.mkdtemp(prefix=s['domain'] + '-', dir=root))
    run(['restic', 'restore', snapshot, '--target', str(destination), '--include', str(s['base'])], env=env, timeout=7200)
    return destination / str(s['base']).lstrip('/')


def verify(sites, env, db):
    for s in sites:
        with tempfile.TemporaryDirectory(prefix='wp-verify-', dir='/srv') as temporary:
            restored = restore_files(s, env, destination=Path(temporary))
            from backup_recovery import verify_manifest
            report = verify_manifest(restored, scratch=True, db=db)
            if any('manifest: missing' in item or 'file availability: no file list' in item for item in report):
                raise ValueError('Backup verification metadata is missing')
            print('PASS ' + s['domain'] + ' backup_files backup_db')
    run(['restic', 'check', '--read-data-subset=5%'], env=env, timeout=7200)


def main():
    parser = HintParser(description=__doc__)
    parser.add_argument('action', nargs='?', default='')
    parser.add_argument('arguments', nargs='*')
    parser.add_argument('--yes', action='store_true')
    parser.add_argument('--activate', action='store_true')
    parser.add_argument('--no-backup', action='store_true',
                        help='Remove one site without a snapshot or archive')
    args = parser.parse_args()
    if args.no_backup and args.action != 'remove':
        parser.error('--no-backup is only valid with remove')
    if os.geteuid() != 0:
        parser.error('Run as root')
    os.umask(0o077)
    # Emergency removal must also work when restic credentials or its mount are lost.
    env = {} if args.no_backup else {**os.environ, **read_env('/etc/restic/env')}
    if not args.no_backup and env.get('BACKUP_REQUIRE_MOUNT', 'true') == 'true' and not os.path.ismount(env['BACKUP_MOUNT']):
        raise RuntimeError('The backup disk is not mounted')
    with operation_lock():
        db = Database()
        if args.action == 'restore':
            if not 1 <= len(args.arguments) <= 2:
                parser.error('restore <domain> [snapshot]')
            s = site(args.arguments[0])
            restored = restore_files(s, env, args.arguments[1] if len(args.arguments) == 2 else None)
            print('restored: ' + str(restored))
            print('dump: ' + str(restored / 'backup/db.sql.gz'))
        elif args.action == 'restore-db':
            if len(args.arguments) != 2 or not args.yes:
                parser.error('restore-db <domain> <dump.sql.gz> --yes')
            s = site(args.arguments[0])
            path = Path(args.arguments[1]).resolve(strict=True)
            manifest = json.loads((path.parent / 'manifest.json').read_text())
            if sha256_file(path) != manifest['sha256']:
                raise ValueError('Dump hash differs from its manifest')
            restore_database(s, path, db, manifest)
            print('PASS database restored')
        elif args.action == 'remove':
            if len(args.arguments) != 1 or not args.yes:
                parser.error('remove <domain> --yes')
            s = site(args.arguments[0])
            if not args.no_backup:
                backup([s], env, db)
            remove_site(s, db, env.get('REMOVED_DIR', '/mnt/backups/removed'),
                        without_backup=args.no_backup)
        elif args.action == 'clone':
            if len(args.arguments) != 2:
                parser.error('clone <source> <target> [--yes] [--activate]')
            clone(site(args.arguments[0]), site(args.arguments[1]), db, confirm=args.yes, activate=args.activate)
        elif args.action == 'verify':
            if len(args.arguments) > 1:
                parser.error('verify [domain]')
            sites = [site(args.arguments[0])] if args.arguments else [site(p.name) for p in SITES.iterdir() if (p / 'conf/site.env').exists()]
            if not sites:
                raise ValueError('No sites selected')
            verify(sites, env, db)
        else:
            if args.arguments:
                parser.error('Unexpected arguments')
            sites = [site(args.action)] if args.action else [site(p.name) for p in SITES.iterdir() if (p / 'conf/site.env').exists()]
            if not sites:
                raise ValueError('No sites selected')
            backup(sites, env, db, full=not args.action)


if __name__ == '__main__':
    def interrupted(signum, frame):
        raise InterruptedError('Operation interrupted')
    signal.signal(signal.SIGTERM, interrupted)
    try:
        main()
    except (Exception, KeyboardInterrupt) as exc:
        print('FAIL wp-backup: ' + str(exc), file=sys.stderr)
        hint('wp-backup', str(exc))
        run(['tg-alert', 'wp-backup failed; inspect the service log'], check=False)
        sys.exit(1)
