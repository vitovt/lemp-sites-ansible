#!/usr/bin/python3 -I
"""Run a command as the current site owner, without selecting another site."""
import sys
sys.path.insert(0, '/usr/local/lib/wp-hosting/lib')
from site_commands import main
from cli_diagnostics import run_cli

if __name__ == '__main__':
    sys.exit(run_cli('site-php', lambda: main('site-php', sys.argv[1:])))
