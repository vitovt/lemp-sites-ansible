#!/usr/bin/env python3
"""Coordinate checked WordPress code updates on a managed hosting server."""
import argparse
from datetime import datetime
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

SHORT = "Usage: wp-update {plan DOMAIN | apply DOMAIN --scope SCOPE | run --automatic --all-sites}\nRun wp-update --help for options and examples."
HELP = """Update managed WordPress code with WP-CLI and scoped Git commits.

Examples:
  wp-update plan example.com
  wp-update apply example.com --scope all --policy minor
  wp-update apply example.com --scope core --policy latest
  wp-update apply example.com --scope plugin:example-plugin --skip-backup-check
  wp-update apply example.com --scope plugin:example-plugin --allow-dirty-target --no-maintenance
  wp-update run --automatic --all-sites

The default backup check requires a completed backup of this site from today.
--skip-backup-check is manual only. It never starts a backup.
--allow-dirty-target is manual only; the target remains uncommitted.
--no-maintenance is manual only. Failed uncertain updates keep maintenance on.
--scope all selects core, plugins, and themes; core selects core only.
--policy minor stays within each component's major version; latest permits it.
Automatic runs use minor policy, clean Git, and the backup check.
"""
BACKUP_MARKERS = Path('/var/lib/wp-hosting/backups')
SLUG = re.compile(r"[a-z0-9][a-z0-9_-]*\Z")


def command(args, *, env=None, check=True):
    result = subprocess.run([str(x) for x in args], env=env, capture_output=True, text=True)
    if check and result.returncode:
        raise RuntimeError(f"{Path(args[0]).name} failed (exit {result.returncode})")
    return result


def library():
    sys.path.insert(0, '/usr/local/lib/wp-hosting/lib')
    from wp_hosting import site, operation_lock
    return site, operation_lock


def git(s, *args, index=None, check=True):
    env = os.environ.copy()
    if index:
        env['GIT_INDEX_FILE'] = str(index)
    return command(['runuser', '-u', s['SITE_USER'], '--', 'git', '-C', s['base'] / 'htdocs', *args], env=env, check=check)


def wp(s, *args, check=True):
    base = s['base']
    return command(['runuser', '-u', s['SITE_USER'], '--', 'env', f'HOME={base}/owner-tmp',
                    f'WP_CLI_CACHE_DIR={base}/owner-tmp/wp-cli-cache', 'php' + s['PHP_VERSION'],
                    '/usr/local/bin/wp', '--path=' + str(base / 'htdocs'), '--skip-plugins',
                    '--skip-themes', '--no-color', *args], check=check)


def policy(domain):
    sys.path.insert(0, '/usr/local/lib/wp-hosting/lib')
    from code_policy import load
    data = load(Path('/srv/sites') / domain)
    return {kind: {name: rule['updates']['reason']
                   for name, rule in data[kind].items()
                   if rule.get('updates', {}).get('hold')}
            for kind in ('plugins', 'themes')}


def backup_today(s):
    directory = BACKUP_MARKERS
    today = datetime.now().astimezone().date().isoformat()
    for path in sorted(directory.glob('*.json'), reverse=True) if directory.exists() else []:
        if path.is_symlink() or path.stat().st_uid != 0 or path.stat().st_mode & 0o022:
            continue
        try:
            item = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(item, dict) or not isinstance(item.get('sites'), list) or not isinstance(item.get('time'), str):
            continue
        if item.get('date') == today and s['domain'] in item.get('sites', []):
            sys.path.insert(0, '/usr/local/lib/wp-hosting/lib')
            from wp_hosting import read_env
            env = {**os.environ, **read_env('/etc/restic/env')}
            snapshot = item.get('snapshot')
            if not isinstance(snapshot, str) or not re.fullmatch(r'[0-9a-f]{64}', snapshot):
                continue
            result = command(['restic', 'snapshots', '--json', snapshot], env=env, check=False)
            if result.returncode:
                continue
            found = json.loads(result.stdout or '[]')
            if found and (len(found) != 1 or found[0].get('id') != snapshot):
                continue
            if not found:
                # Old writers saved the pre-tag ID. Restic preserves that ID in
                # original. New markers also carry the unique run tag for retags.
                catalog = command(['restic', 'snapshots', '--json'], env=env, check=False)
                if catalog.returncode:
                    continue
                run_tag = item.get('run_tag')
                valid_tag = isinstance(run_tag, str) and re.fullmatch(r'run-[0-9]+', run_tag)
                found = [entry for entry in json.loads(catalog.stdout or '[]')
                         if entry.get('original') == snapshot or
                         (valid_tag and run_tag in entry.get('tags', []))]
            if len(found) != 1 or 'complete' not in found[0].get('tags', []):
                continue
            snapshot = found[0].get('id')
            if not isinstance(snapshot, str) or not re.fullmatch(r'[0-9a-f]{64}', snapshot):
                continue
            listing = command(['restic', 'ls', '--json', snapshot], env=env, check=False)
            if listing.returncode:
                continue
            names = {entry.get('path') for line in listing.stdout.splitlines()
                     if (entry := json.loads(line)).get('struct_type') == 'node'}
            base = str(s['base'])
            if {base + '/backup/db.sql.gz', base + '/backup/manifest.json'} <= names:
                return snapshot, item['time']
    return None


def inventory(s, scope, release, holds, log=None):
    result = []
    if scope in ('all', 'core'):
        old = wp(s, 'core', 'version').stdout.strip()
        updates = json.loads(wp(s, 'core', 'check-update', '--format=json').stdout or '[]')
        selected = next((x for x in updates if release == 'latest' or x.get('update_type') == 'minor'), None)
        if selected:
            result.append(('core', 'core', old, selected['version'], ['wp-admin', 'wp-includes',
                'index.php', 'wp-activate.php', 'wp-blog-header.php', 'wp-comments-post.php',
                'wp-config-sample.php',
                'wp-cron.php', 'wp-links-opml.php', 'wp-load.php', 'wp-login.php',
                'wp-mail.php', 'wp-settings.php', 'wp-signup.php', 'wp-trackback.php',
                'xmlrpc.php', 'license.txt', 'readme.html']))
    for kind in ('plugin', 'theme'):
        if scope not in ('all', kind) and not scope.startswith(kind + ':'):
            continue
        entries = json.loads(wp(s, kind, 'list', '--format=json').stdout or '[]')
        for item in entries:
            name = item['name']
            if not SLUG.fullmatch(name) or (scope.startswith(kind + ':') and name != scope.split(':', 1)[1]):
                continue
            if name in holds.get(kind + 's', {}):
                message = f'SKIP {kind}:{name}: held: {holds[kind + "s"][name]}'
                if log is None:
                    print(message)
                else:
                    log.append(message)
                continue
            if item.get('update') != 'available':
                continue
            old, new = item['version'], item['update_version']
            if release == 'minor' and old.split('.')[0] != new.split('.')[0]:
                continue
            result.append((kind, name, old, new, [f'wp-content/{kind}s/{name}']))
    return result


def changed(s):
    return {x for x in git(s, 'status', '--porcelain=v1', '-z', '--untracked-files=all').stdout.split('\0') if x}


def target_dirty(s, paths):
    return bool(git(s, 'status', '--porcelain=v1', '--', *paths).stdout)


def commit_paths(s, paths, message):
    root = s['base'] / 'owner-tmp'
    fd, name = tempfile.mkstemp(prefix='wp-update-index-', dir=root)
    os.close(fd)
    uid = __import__('pwd').getpwnam(s['SITE_USER']).pw_uid
    if os.stat(name).st_uid != uid:
        os.chown(name, uid, -1)
    index = Path(name)
    index.unlink()
    try:
        old = git(s, 'rev-parse', 'HEAD').stdout.strip()
        git(s, 'read-tree', 'HEAD', index=index)
        git(s, 'add', '-A', '--', *paths, index=index)
        tree = git(s, 'write-tree', index=index).stdout.strip()
        if tree == git(s, 'rev-parse', 'HEAD^{tree}').stdout.strip():
            return None
        identity = dict(GIT_AUTHOR_NAME='wp-update', GIT_AUTHOR_EMAIL='root@localhost',
                        GIT_COMMITTER_NAME='wp-update', GIT_COMMITTER_EMAIL='root@localhost')
        # Use the site owner for Git. A temporary index omits unrelated staged files.
        result = command(['runuser', '-u', s['SITE_USER'], '--', 'env',
                          *[f'{k}={v}' for k, v in identity.items()], 'git', '-C', s['base'] / 'htdocs',
                          'commit-tree', tree, '-p', old, '-m', message])
        new = result.stdout.strip()
        git(s, 'update-ref', 'HEAD', new, old)
        git(s, 'reset', '-q', 'HEAD', '--', *paths)
        return new
    finally:
        index.unlink(missing_ok=True)


def report(s, lines):
    # Show the result even when file or syslog delivery fails. Do not log argv,
    # credentials or raw subprocess output; these lines are the existing summary.
    for item in lines:
        print(item, file=sys.stderr if item.startswith(('FAIL', 'SKIP')) else sys.stdout, flush=True)
    line = '\n'.join(lines) + '\n'
    log = s['base'] / 'logs' / ('wp-update-' + datetime.now().strftime('%Y%m%d-%H%M%S-%f') + '.log')
    try:
        descriptor = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(descriptor, 'w') as stream:
            stream.write(line)
        print('LOG ' + str(log), file=sys.stderr if lines[-1] == 'FAIL' else sys.stdout, flush=True)
    except OSError:
        print('WARNING update log could not be written: ' + str(log) + '; see journalctl -t wp-update',
              file=sys.stderr, flush=True)
    try:
        subprocess.run(['logger', '-t', 'wp-update'], input=line, text=True, check=False)
    except OSError:
        print('WARNING syslog delivery is unavailable', file=sys.stderr, flush=True)


def apply(s, args):
    lines = [f"START {s['domain']} {datetime.now().astimezone().isoformat()} scope={args.scope} policy={args.policy}"]
    failed = False
    unsafe = False
    try:
        marker = s['base'] / 'conf/maintenance'
        if marker.exists():
            raise RuntimeError('Site is already in maintenance')
        snapshot = None if args.skip_backup_check else backup_today(s)
        if not args.skip_backup_check and not snapshot:
            raise RuntimeError('No completed site backup from today')
        lines.append('BACKUP ' + (f'{snapshot[0]} {snapshot[1]}' if snapshot else 'check skipped'))
        if not git(s, 'rev-parse', '--verify', 'HEAD', check=False).returncode == 0:
            raise RuntimeError('Git baseline is missing')
        if args.automatic and changed(s):
            raise RuntimeError('Git index or worktree is not clean')
        entries = inventory(s, args.scope, args.policy, policy(s['domain']), lines)
        if args.no_maintenance:
            lines.append('WARNING hosting maintenance gate disabled by operator')
        for kind, name, old, new, paths in entries:
            if args.automatic and kind == 'plugin':
                verified = wp(s, 'plugin', 'verify-checksums', name, '--strict', check=False)
                if verified.returncode or not re.search(r'Verified 1 of 1 plugins', verified.stdout):
                    lines.append(f'SKIP {kind}:{name}: source checksum is unavailable or does not match')
                    continue
            dirty = target_dirty(s, paths)
            if dirty and (args.automatic or not args.allow_dirty_target):
                lines.append(f'SKIP {kind}:{name}: target has local changes')
                failed = True
                continue
            before = changed(s)
            if not args.no_maintenance and not marker.exists():
                marker.write_text('managed update\n')
                marker.chmod(0o644)
                owned_marker = True
            else:
                owned_marker = False
            try:
                command_args = [kind, 'update', name] if kind != 'core' else ['core', 'update']
                if args.policy == 'minor':
                    command_args.append('--minor')
                wp(s, *command_args)
                got = wp(s, kind, 'get', name, '--field=version').stdout.strip() if kind != 'core' else wp(s, 'core', 'version').stdout.strip()
                if got != new:
                    raise RuntimeError(f'{kind}:{name} expected {new}, got {got}')
                if kind == 'core':
                    wp(s, 'core', 'update-db')
                    wp(s, 'core', 'verify-checksums')
                elif kind == 'plugin':
                    verify = wp(s, 'plugin', 'verify-checksums', name, '--strict', check=False)
                    if verify.returncode and args.automatic:
                        raise RuntimeError('Plugin checksum verification failed')
                command(['/usr/local/sbin/site-fix-perms', s['domain']])
                health = command(['curl', '--noproxy', '*', '-sk', '--max-time', '20', '-o', '/dev/null', '-w', '%{http_code}',
                    '--unix-socket', '/run/wp-hosting/health.sock', '-H', 'X-WP-Health: 1',
                    'https://' + s['domain'] + '/?wp-update-health=1']).stdout
                if health != '200':
                    raise RuntimeError('Uncached health check failed')
                outside = changed(s) - before
                if any(not any(x[3:] == p or x[3:].startswith(p + '/') for p in paths) for x in outside):
                    raise RuntimeError('Update changed paths outside the selected component')
                commit = None if dirty else commit_paths(s, paths, f'Update {kind}:{name} {old} to {new}')
                lines.append(f'PASS {kind}:{name} {old} -> {new} commit={commit or "none"}')
            except Exception as exc:
                lines.append(f'FAIL {kind}:{name}: {exc}')
                failed = True
                unsafe = True
                break
            finally:
                if owned_marker and not unsafe:
                    marker.unlink(missing_ok=True)
        if not entries:
            lines.append('PASS no eligible updates')
    except Exception as exc:
        lines.append(f'FAIL {exc}')
        failed = True
    lines.append('FAIL' if failed else 'PASS')
    report(s, lines)
    if failed:
        subprocess.run(['/usr/local/sbin/tg-alert', f'wp-update failed: {s["domain"]}; see site log'], check=False)
    return failed


def main(argv):
    if not argv:
        print(SHORT)
        return 0
    if argv == ['--help']:
        print(SHORT + '\n\n' + HELP)
        return 0
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument('action', choices=['plan', 'apply', 'run'])
    parser.add_argument('domain', nargs='?')
    parser.add_argument('--scope')
    parser.add_argument('--policy', choices=['minor', 'latest'])
    parser.add_argument('--automatic', action='store_true')
    parser.add_argument('--all-sites', action='store_true')
    parser.add_argument('--skip-backup-check', action='store_true')
    parser.add_argument('--allow-dirty-target', action='store_true')
    parser.add_argument('--no-maintenance', action='store_true')
    args = parser.parse_args(argv)
    if args.action == 'run':
        if args.domain or not args.automatic or not args.all_sites or args.skip_backup_check or args.allow_dirty_target or args.no_maintenance:
            parser.error('run requires --automatic --all-sites')
        args.scope, args.policy = 'all', 'minor'
    else:
        if not args.domain or args.automatic or args.all_sites:
            parser.error('plan/apply require one domain')
        if args.action == 'apply' and not args.scope:
            parser.error('apply requires --scope')
        if args.scope and args.scope not in ('all', 'core') and not re.fullmatch(r'(plugin|theme):[a-z0-9][a-z0-9_-]*', args.scope):
            parser.error('invalid scope')
        if args.action == 'apply' and args.scope in ('all', 'core') and not args.policy:
            parser.error('all/core require --policy')
        args.scope = args.scope or 'all'
        args.policy = args.policy or 'latest'
    if args.action == 'plan' and (args.skip_backup_check or args.allow_dirty_target or args.no_maintenance):
        parser.error('plan does not accept apply options')
    if os.geteuid() != 0:
        parser.error('run with sudo')
    site, operation_lock = library()
    if args.action == 'plan':
        s = site(args.domain)
        print('BACKUP', backup_today(s) or 'missing today')
        print('GIT', 'dirty' if changed(s) else 'clean')
        for item in inventory(s, args.scope, args.policy, policy(s['domain'])):
            print('UPDATE', *item[:4])
        return 0
    domains = [p.name for p in sorted(Path('/srv/sites').iterdir()) if (p / 'conf/wordpress-installed').exists()] if args.action == 'run' else [args.domain]
    failed = False
    for domain in domains:
        try:
            with operation_lock():
                failed = apply(site(domain), args) or failed
        except Exception as exc:
            print(f'FAIL {domain}: {exc}', file=sys.stderr)
            subprocess.run(['/usr/local/sbin/tg-alert', f'wp-update failed: {domain}; inspect logs'], check=False)
            failed = True
    return int(failed)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
