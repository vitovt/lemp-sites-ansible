#!/usr/bin/env python3
"""Coordinate checked WordPress code updates on a managed hosting server."""
import argparse
from datetime import datetime
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile

SHORT = """Usage: wp-update COMMAND [SITE] [OPTIONS]

Commands:
  plan SITE     Show available updates. Do not apply them.
    wp-update plan example.com
  apply SITE    Update selected components of one site.
    wp-update apply example.com --scope core --policy minor
  run           Automatically update all installed sites.
    wp-update run --automatic --all-sites

Run wp-update COMMAND --help for mode options.
Run wp-update --help for the full reference."""
SCOPES = """Scope:
  all            Core, plugins, and themes. Honour local holds.
  core           WordPress core only.
  plugins        All plugins only. Honour local holds.
  themes         All themes only. Honour local holds.
  plugin:SLUG    One plugin. Example: plugin:akismet
  theme:SLUG     One theme. Example: theme:allium

Policy:
  minor          Core: WordPress minor releases, such as 5.9.19 -> 5.9.20.
                 Plugins/themes: keep the first version number.
                 Example: 3.9 -> 3.10 is allowed; 3.x -> 4.x is not.
  latest         Permit the latest available version, including major updates."""
SAFETY = """Safety options (manual apply only):
  --skip-backup-check    Skip today's completed-backup check. No backup is created.
  --allow-dirty-target   Permit local edits in the update target to be overwritten.
                        Do not automatically commit that target.
  --no-maintenance      Do not enable the hosting maintenance gate.

Without these options, apply requires today's completed site backup and a clean
update target. Unrelated local changes are allowed and are not added to the commit.
An uncertain failed update keeps its maintenance gate enabled.
No automatic rollback is performed."""
CHANGELOG_HELP = """Changelog (plan, apply, and run):
  --changelog brief    Show up to five releases with short notes. Default.
  --changelog full     Show all published entries in OLD < release <= NEW.
  --changelog none     Do not fetch, print, or save release notes.

Plugin notes come from WordPress.org. Missing notes never fail an update.
Core uses a release-note link. Themes and private plugins may have no notes.
The author can omit releases. Partial ranges are marked; completeness is not guaranteed.
After apply/run, save full notes for successful components in the site's logs.
Plan prints notes only. Release notes are not sent to Telegram or syslog.

Changelog examples:
  wp-update plan example.com --scope plugins --changelog full
  wp-update apply example.com --scope plugin:akismet --changelog none"""
MODE_HELP = {
    'plan': """Usage: wp-update plan SITE [--scope SCOPE] [--policy POLICY]

Plan:
  Show available updates, backup status, and Git status. Do not update the site.
  Defaults: --scope all --policy latest.
  Apply-only safety options are not accepted.

""" + SCOPES + """

Examples:
  wp-update plan example.com
  wp-update plan example.com --scope core --policy minor
  wp-update plan example.com --scope plugin:akismet""",
    'apply': """Usage: wp-update apply SITE --scope SCOPE [--policy POLICY] [OPTIONS]

Apply:
  Manually update one site's selected components. Run as root.
  --scope is required. For all/core/plugins/themes, --policy is also required.
  For one plugin/theme, the default policy is latest.

""" + SCOPES + "\n\n" + SAFETY + """

Examples:
  wp-update apply example.com --scope core --policy minor
  wp-update apply example.com --scope all --policy minor
  wp-update apply example.com --scope plugins --policy minor
  wp-update apply example.com --scope themes --policy minor
  wp-update apply example.com --scope plugin:akismet --policy latest
  wp-update apply example.com --scope theme:allium --policy minor
  wp-update apply example.com --scope plugin:akismet --skip-backup-check""",
    'run': """Usage: wp-update run --automatic --all-sites

Run:
  Automatically update all installed sites. Use from cron or systemd as root.
  Both --automatic and --all-sites are required. Do not supply a domain.
  Fixed selection: all components, minor policy. Honour local holds.
  Require clean Git and today's completed site backup.
  Manual safety bypass options are not accepted. No backup is created.
  Existing --scope/--policy arguments are overridden by all/minor.

""" + SCOPES[SCOPES.index('Policy:'):].split('  latest', 1)[0].rstrip() + """

Examples:
  wp-update run --automatic --all-sites""",
}
MODE_HELP = {name: text + '\n\n' + CHANGELOG_HELP for name, text in MODE_HELP.items()}
HELP = SHORT + "\n\n" + "\n\n".join(MODE_HELP.values())


def terminal_text(text, color, stream):
    if stream.isatty() and os.environ.get('TERM', 'dumb') != 'dumb' and 'NO_COLOR' not in os.environ:
        return f'\033[{color}m{text}\033[0m'
    return text


def print_help_text(text):
    for line in text.splitlines():
        heading = line.startswith('Usage:') or (line and not line.startswith(' ') and line.endswith(':'))
        print(terminal_text(line, '1;36', sys.stdout) if heading else line)


def print_status(line, stream=None):
    stream = sys.stdout if stream is None else stream
    color = '31' if line.startswith('FAIL') else '33' if line.startswith(('HINT', 'SKIP', 'WARNING')) else '32' if line.startswith('PASS') else None
    print(terminal_text(line, color, stream) if color else line, file=stream, flush=True)


BACKUP_MARKERS = Path('/var/lib/wp-hosting/backups')
SLUG = re.compile(r"[a-z0-9][a-z0-9_-]*\Z")


def error_hints(s, reason):
    """Print-only advice. Never accept changes or disable a guard automatically."""
    domain = shlex.quote(s['domain'])
    base = shlex.quote(str(s['base']))
    inspect = f"jump-in {domain}; then run git status --short and git diff."
    checks = f"wp-site check {domain}"
    if 'No completed site backup' in reason:
        return [f"Create a backup: wp-backup {domain}; then retry the update.",
                "For a manual update only, add --skip-backup-check to your apply command. "
                "This skips backup validation; recovery data may be unavailable."]
    if 'already in maintenance' in reason:
        return [f"Inspect {base}/conf/maintenance and the previous update log. Run {checks}.",
                f"After you confirm that the site is safe, remove the hosting gate: rm -- {base}/conf/maintenance; then retry."]
    if 'Git baseline is missing' in reason:
        return [inspect, "Review code and ignore rules first. Create a reviewed initial commit as the site owner. "
                'Stage only reviewed paths with git add -- PATH, then run git commit -m "Initial reviewed code". '
                "Do not accept unknown code with a bulk commit."]
    if 'not clean' in reason or 'target has local changes' in reason:
        return [inspect, "Commit only reviewed changes, or save them outside the update target before retrying.",
                "For intentional target edits, use manual apply with --allow-dirty-target. "
                "The target can be overwritten and will not be committed automatically. Automatic mode requires clean Git."]
    if 'held:' in reason:
        component = re.search(r'(plugin|theme):([a-z0-9][a-z0-9_-]*): held:', reason)
        kind, name = component.groups() if component else ('plugin', 'PLUGIN')
        return [f"Review the local rule: wp-site policy show {domain}.",
                f"To permit updates, use wp-site policy unhold {domain} {shlex.quote(name)} --kind {kind}. "
                "Replace PLUGIN if shown. Keep the hold for required local patches."]
    if 'checksum' in reason.lower():
        return [f"Inspect details: wp-site check {domain} plugins.",
                "Compare the affected component with its trusted release. Review local patches and code policy. "
                "Do not accept unknown differences or disable checks only to make the update pass.",
                "If this happened after an update, inspect the site log and maintenance gate before retrying."]
    if 'expected ' in reason:
        return [f"Check installed versions: jump-in {domain}; then run wp core version, wp plugin list, and wp theme list.",
                "Review the update log, package availability, holds, and network access. Do not assume the update completed."]
    if 'health check' in reason:
        return [f"Run {checks}; inspect Nginx and PHP-FPM service logs and the site error log.",
                "Check the database and health socket /run/wp-hosting/health.sock. "
                "Keep maintenance enabled until you review the failure."]
    if 'outside the selected component' in reason:
        return [inspect, "Review every unexpected path. Preserve evidence and compare with a trusted backup. "
                "No automatic rollback is performed. Do not bulk-commit these files."]
    if any(word in reason for word in ('facts', 'Invalid domain', 'Site path', 'Unknown site')):
        return [f"Check the domain and trusted facts at {base}/conf/site.env. Do not bypass ownership or symlink checks.",
                "On the controller, review the site's inventory, run scripts/lemp SERVER doctor, "
                "then apply the corrected configuration with scripts/lemp SERVER site. Replace SERVER with the inventory name."]
    if 'Unsafe operation lock' in reason:
        return ["Inspect /run/lock/wp-hosting.lock ownership and symlinks as root. "
                "Stop and investigate unexpected replacement. Do not bypass the lock or weaken its permissions."]
    if 'lock' in reason.lower():
        return ["Run systemctl status wp-backup.service and ps aux to find the active operation. "
                "Wait for it to finish, then retry. Do not delete the lock file to bypass a running task."]
    return [f"Run {checks}; inspect the site update log and journalctl -t wp-update.",
            f"Check site facts in {base}/conf/site.env, tool availability, permissions, disk space, "
            "and network access. Retry only after you identify the failed step. "
            "If files changed, review Git and the maintenance gate first."]


def diagnostic(s, reason):
    return [reason, *('HINT ' + hint for hint in error_hints(s, reason))]


class HelpParser(argparse.ArgumentParser):
    def error(self, message):
        stream = sys.stderr
        print(terminal_text('ERROR', '31', stream), file=stream)
        print('  ' + message + '\n', file=stream)
        if 'scope' in message.lower():
            print(terminal_text('VALID VALUES', '1;36', stream), file=stream)
            print('  all\n  core\n  plugins\n  themes\n  plugin:SLUG\n  theme:SLUG\n', file=stream)
        print(terminal_text('HINT', '33', stream), file=stream)
        print('  Run wp-update --help or wp-update COMMAND --help.\n'
              '  Run updates as root (or use sudo).\n', file=stream)
        print(terminal_text('EXAMPLE', '1;36', stream), file=stream)
        print('  wp-update apply example.com --scope core --policy minor', file=stream)
        self.exit(2)


def command(args, *, env=None, check=True):
    result = subprocess.run([str(x) for x in args], env=env, capture_output=True, text=True)
    if check and result.returncode:
        raise RuntimeError(f"{Path(args[0]).name} failed (exit {result.returncode})")
    return result


def library():
    sys.path.insert(0, '/usr/local/lib/wp-hosting/lib')
    from wp_hosting import site, operation_lock
    return site, operation_lock


def git(s, *args, index=None, check=True):
    env = os.environ.copy()
    if index:
        env['GIT_INDEX_FILE'] = str(index)
    return command(['runuser', '-u', s['SITE_USER'], '--', 'git', '-C', s['base'] / 'htdocs', *args], env=env, check=check)


def wp(s, *args, check=True):
    base = s['base']
    return command(['runuser', '-u', s['SITE_USER'], '--', 'env', f'HOME={base}/owner-tmp',
                    f'WP_CLI_CACHE_DIR={base}/owner-tmp/wp-cli-cache', 'php' + s['PHP_VERSION'],
                    '/usr/local/bin/wp', '--path=' + str(base / 'htdocs'), '--skip-plugins',
                    '--skip-themes', '--no-color', *args], check=check)


def policy(domain):
    sys.path.insert(0, '/usr/local/lib/wp-hosting/lib')
    from code_policy import load
    data = load(Path('/srv/sites') / domain)
    return {kind: {name: rule['updates']['reason']
                   for name, rule in data[kind].items()
                   if rule.get('updates', {}).get('hold')}
            for kind in ('plugins', 'themes')}


def backup_today(s):
    directory = BACKUP_MARKERS
    today = datetime.now().astimezone().date().isoformat()
    for path in sorted(directory.glob('*.json'), reverse=True) if directory.exists() else []:
        if path.is_symlink() or path.stat().st_uid != 0 or path.stat().st_mode & 0o022:
            continue
        try:
            item = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(item, dict) or not isinstance(item.get('sites'), list) or not isinstance(item.get('time'), str):
            continue
        if item.get('date') == today and s['domain'] in item.get('sites', []):
            sys.path.insert(0, '/usr/local/lib/wp-hosting/lib')
            from wp_hosting import read_env
            env = {**os.environ, **read_env('/etc/restic/env')}
            snapshot = item.get('snapshot')
            if not isinstance(snapshot, str) or not re.fullmatch(r'[0-9a-f]{64}', snapshot):
                continue
            result = command(['restic', 'snapshots', '--json', snapshot], env=env, check=False)
            if result.returncode:
                continue
            found = json.loads(result.stdout or '[]')
            if found and (len(found) != 1 or found[0].get('id') != snapshot):
                continue
            if not found:
                # Old writers saved the pre-tag ID. Restic preserves that ID in
                # original. New markers also carry the unique run tag for retags.
                catalog = command(['restic', 'snapshots', '--json'], env=env, check=False)
                if catalog.returncode:
                    continue
                run_tag = item.get('run_tag')
                valid_tag = isinstance(run_tag, str) and re.fullmatch(r'run-[0-9]+', run_tag)
                found = [entry for entry in json.loads(catalog.stdout or '[]')
                         if entry.get('original') == snapshot or
                         (valid_tag and run_tag in entry.get('tags', []))]
            if len(found) != 1 or 'complete' not in found[0].get('tags', []):
                continue
            snapshot = found[0].get('id')
            if not isinstance(snapshot, str) or not re.fullmatch(r'[0-9a-f]{64}', snapshot):
                continue
            listing = command(['restic', 'ls', '--json', snapshot], env=env, check=False)
            if listing.returncode:
                continue
            names = {entry.get('path') for line in listing.stdout.splitlines()
                     if (entry := json.loads(line)).get('struct_type') == 'node'}
            base = str(s['base'])
            if {base + '/backup/db.sql.gz', base + '/backup/manifest.json'} <= names:
                return snapshot, item['time']
    return None


def inventory(s, scope, release, holds, log=None):
    result = []
    if scope in ('all', 'core'):
        old = wp(s, 'core', 'version').stdout.strip()
        updates = json.loads(wp(s, 'core', 'check-update', '--format=json').stdout or '[]')
        selected = next((x for x in updates if release == 'latest' or x.get('update_type') == 'minor'), None)
        if selected:
            result.append(('core', 'core', old, selected['version'], ['wp-admin', 'wp-includes',
                'index.php', 'wp-activate.php', 'wp-blog-header.php', 'wp-comments-post.php',
                'wp-config-sample.php',
                'wp-cron.php', 'wp-links-opml.php', 'wp-load.php', 'wp-login.php',
                'wp-mail.php', 'wp-settings.php', 'wp-signup.php', 'wp-trackback.php',
                'xmlrpc.php', 'license.txt', 'readme.html']))
    for kind in ('plugin', 'theme'):
        if scope not in ('all', kind + 's') and not scope.startswith(kind + ':'):
            continue
        entries = json.loads(wp(s, kind, 'list', '--format=json').stdout or '[]')
        for item in entries:
            name = item['name']
            if not SLUG.fullmatch(name) or (scope.startswith(kind + ':') and name != scope.split(':', 1)[1]):
                continue
            if name in holds.get(kind + 's', {}):
                message = f'SKIP {kind}:{name}: held: {holds[kind + "s"][name]}'
                if log is None:
                    for line in diagnostic(s, message):
                        print(line)
                else:
                    log.append(message)
                continue
            if item.get('update') != 'available':
                continue
            old, new = item['version'], item['update_version']
            if release == 'minor' and old.split('.')[0] != new.split('.')[0]:
                continue
            result.append((kind, name, old, new, [f'wp-content/{kind}s/{name}']))
    return result


def changed(s):
    return {x for x in git(s, 'status', '--porcelain=v1', '-z', '--untracked-files=all').stdout.split('\0') if x}


def target_dirty(s, paths):
    return bool(git(s, 'status', '--porcelain=v1', '--', *paths).stdout)


def commit_paths(s, paths, message):
    root = s['base'] / 'owner-tmp'
    fd, name = tempfile.mkstemp(prefix='wp-update-index-', dir=root)
    os.close(fd)
    uid = __import__('pwd').getpwnam(s['SITE_USER']).pw_uid
    if os.stat(name).st_uid != uid:
        os.chown(name, uid, -1)
    index = Path(name)
    index.unlink()
    try:
        old = git(s, 'rev-parse', 'HEAD').stdout.strip()
        git(s, 'read-tree', 'HEAD', index=index)
        git(s, 'add', '-A', '--', *paths, index=index)
        tree = git(s, 'write-tree', index=index).stdout.strip()
        if tree == git(s, 'rev-parse', 'HEAD^{tree}').stdout.strip():
            return None
        identity = dict(GIT_AUTHOR_NAME='wp-update', GIT_AUTHOR_EMAIL='root@localhost',
                        GIT_COMMITTER_NAME='wp-update', GIT_COMMITTER_EMAIL='root@localhost')
        # Use the site owner for Git. A temporary index omits unrelated staged files.
        result = command(['runuser', '-u', s['SITE_USER'], '--', 'env',
                          *[f'{k}={v}' for k, v in identity.items()], 'git', '-C', s['base'] / 'htdocs',
                          'commit-tree', tree, '-p', old, '-m', message])
        new = result.stdout.strip()
        git(s, 'update-ref', 'HEAD', new, old)
        git(s, 'reset', '-q', 'HEAD', '--', *paths)
        return new
    finally:
        index.unlink(missing_ok=True)


def report(s, lines):
    # Show the result even when file or syslog delivery fails. Do not log argv,
    # credentials or raw subprocess output; these lines are the existing summary.
    expanded = []
    for item in lines:
        expanded.extend(diagnostic(s, item) if item.startswith(('FAIL ', 'SKIP ')) else [item])
    lines = expanded
    for item in lines:
        print_status(item, sys.stderr if item.startswith(('FAIL', 'SKIP', 'HINT')) else sys.stdout)
    line = '\n'.join(lines) + '\n'
    log = s['base'] / 'logs' / ('wp-update-' + datetime.now().strftime('%Y%m%d-%H%M%S-%f') + '.log')
    try:
        descriptor = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(descriptor, 'w') as stream:
            stream.write(line)
        print('LOG ' + str(log), file=sys.stderr if lines[-1] == 'FAIL' else sys.stdout, flush=True)
    except OSError:
        print('WARNING update log could not be written: ' + str(log) + '; HINT check logs directory ownership and free space with df -h; see journalctl -t wp-update',
              file=sys.stderr, flush=True)
    try:
        subprocess.run(['logger', '-t', 'wp-update'], input=line, text=True, check=False)
    except OSError:
        print('WARNING syslog delivery is unavailable; HINT check command -v logger and systemctl status systemd-journald; use the site log or terminal result.', file=sys.stderr, flush=True)


def show_changelogs(entries, mode, site=None):
    """Report after component processing. Never change update status."""
    if mode == 'none' or not entries:
        return
    try:
        sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
        from wp_changelog import render, save_notes
        display, complete = render(entries, mode)
        if display:
            print_help_text('\n' + display)
        if site and complete:
            try:
                path = save_notes(site, complete)
                print('CHANGELOG FILE ' + str(path))
            except Exception:
                print_status('WARNING changelog file could not be saved; check the site logs directory and free space.', sys.stderr)
    except Exception:
        print_status('WARNING changelog unavailable; update result is unchanged.', sys.stderr)


def apply(s, args):
    lines = [f"START {s['domain']} {datetime.now().astimezone().isoformat()} scope={args.scope} policy={args.policy}"]
    failed = False
    unsafe = False
    completed = []
    try:
        marker = s['base'] / 'conf/maintenance'
        if marker.exists():
            raise RuntimeError('Site is already in maintenance')
        snapshot = None if args.skip_backup_check else backup_today(s)
        if not args.skip_backup_check and not snapshot:
            raise RuntimeError('No completed site backup from today')
        lines.append('BACKUP ' + (f'{snapshot[0]} {snapshot[1]}' if snapshot else 'check skipped'))
        if not git(s, 'rev-parse', '--verify', 'HEAD', check=False).returncode == 0:
            raise RuntimeError('Git baseline is missing')
        if args.automatic and changed(s):
            raise RuntimeError('Git index or worktree is not clean')
        entries = inventory(s, args.scope, args.policy, policy(s['domain']), lines)
        if args.no_maintenance:
            lines.append('WARNING hosting maintenance gate disabled by operator')
        for kind, name, old, new, paths in entries:
            if args.automatic and kind == 'plugin':
                verified = wp(s, 'plugin', 'verify-checksums', name, '--strict', check=False)
                if verified.returncode or not re.search(r'Verified 1 of 1 plugins', verified.stdout):
                    lines.append(f'SKIP {kind}:{name}: source checksum is unavailable or does not match')
                    continue
            dirty = target_dirty(s, paths)
            if dirty and (args.automatic or not args.allow_dirty_target):
                lines.append(f'SKIP {kind}:{name}: target has local changes')
                failed = True
                continue
            before = changed(s)
            if not args.no_maintenance and not marker.exists():
                marker.write_text('managed update\n')
                marker.chmod(0o644)
                owned_marker = True
            else:
                owned_marker = False
            try:
                command_args = [kind, 'update', name] if kind != 'core' else ['core', 'update']
                if args.policy == 'minor':
                    command_args.append('--minor')
                wp(s, *command_args)
                got = wp(s, kind, 'get', name, '--field=version').stdout.strip() if kind != 'core' else wp(s, 'core', 'version').stdout.strip()
                if got != new:
                    raise RuntimeError(f'{kind}:{name} expected {new}, got {got}')
                if kind == 'core':
                    wp(s, 'core', 'update-db')
                    wp(s, 'core', 'verify-checksums')
                elif kind == 'plugin':
                    verify = wp(s, 'plugin', 'verify-checksums', name, '--strict', check=False)
                    if verify.returncode and args.automatic:
                        raise RuntimeError('Plugin checksum verification failed')
                command(['/usr/local/sbin/site-fix-perms', s['domain']])
                health = command(['curl', '--noproxy', '*', '-sk', '--max-time', '20', '-o', '/dev/null', '-w', '%{http_code}',
                    '--unix-socket', '/run/wp-hosting/health.sock', '-H', 'X-WP-Health: 1',
                    'https://' + s['domain'] + '/?wp-update-health=1']).stdout
                if health != '200':
                    raise RuntimeError('Uncached health check failed')
                outside = changed(s) - before
                if any(not any(x[3:] == p or x[3:].startswith(p + '/') for p in paths) for x in outside):
                    raise RuntimeError('Update changed paths outside the selected component')
                commit = None if dirty else commit_paths(s, paths, f'Update {kind}:{name} {old} to {new}')
                lines.append(f'PASS {kind}:{name} {old} -> {new} commit={commit or "none"}')
                completed.append((kind, name, old, new))
            except Exception as exc:
                lines.append(f'FAIL {kind}:{name}: {exc}')
                failed = True
                unsafe = True
                break
            finally:
                if owned_marker and not unsafe:
                    marker.unlink(missing_ok=True)
        if not entries:
            lines.append('PASS no eligible updates')
    except Exception as exc:
        lines.append(f'FAIL {exc}')
        failed = True
    lines.append('FAIL' if failed else 'PASS')
    report(s, lines)
    show_changelogs(completed, getattr(args, 'changelog', 'brief'), s)
    if failed:
        subprocess.run(['/usr/local/sbin/tg-alert', f'wp-update failed: {s["domain"]}; see site log'], check=False)
    return failed


def main(argv):
    if not argv:
        print_help_text(SHORT)
        return 0
    if '--help' in argv or '-h' in argv:
        mode = argv[0] if argv[0] in MODE_HELP else None
        print_help_text(MODE_HELP[mode] if mode else HELP)
        return 0
    parser = HelpParser(add_help=False)
    parser.add_argument('action', choices=['plan', 'apply', 'run'])
    parser.add_argument('domain', nargs='?')
    parser.add_argument('--scope')
    parser.add_argument('--policy', choices=['minor', 'latest'])
    parser.add_argument('--changelog', choices=['full', 'brief', 'none'], default='brief')
    parser.add_argument('--automatic', action='store_true')
    parser.add_argument('--all-sites', action='store_true')
    parser.add_argument('--skip-backup-check', action='store_true')
    parser.add_argument('--allow-dirty-target', action='store_true')
    parser.add_argument('--no-maintenance', action='store_true')
    args = parser.parse_args(argv)
    if args.action == 'run':
        if args.domain or not args.automatic or not args.all_sites or args.skip_backup_check or args.allow_dirty_target or args.no_maintenance:
            parser.error('run requires --automatic --all-sites')
        args.scope, args.policy = 'all', 'minor'
    else:
        if not args.domain or args.automatic or args.all_sites:
            parser.error('plan/apply require one domain')
        if args.action == 'apply' and not args.scope:
            parser.error('apply requires --scope')
        if args.scope and args.scope not in ('all', 'core', 'plugins', 'themes') and not re.fullmatch(r'(plugin|theme):[a-z0-9][a-z0-9_-]*', args.scope):
            parser.error('invalid scope')
        if args.action == 'apply' and args.scope in ('all', 'core', 'plugins', 'themes') and not args.policy:
            parser.error('all/core/plugins/themes require --policy')
        args.scope = args.scope or 'all'
        args.policy = args.policy or 'latest'
    if args.action == 'plan' and (args.skip_backup_check or args.allow_dirty_target or args.no_maintenance):
        parser.error('plan does not accept apply options')
    if os.geteuid() != 0:
        parser.error('run with sudo')
    site, operation_lock = library()
    if args.action == 'plan':
        try:
            s = site(args.domain)
            backup = backup_today(s)
            print('BACKUP', backup or 'missing today')
            if not backup:
                for hint in error_hints(s, 'No completed site backup from today'):
                    print_status('HINT ' + hint)
            dirty = changed(s)
            print('GIT', 'dirty' if dirty else 'clean')
            if dirty:
                for hint in error_hints(s, 'Git index or worktree is not clean'):
                    print_status('HINT ' + hint)
            entries = inventory(s, args.scope, args.policy, policy(s['domain']))
            for item in entries:
                print('UPDATE', *item[:4])
            show_changelogs(entries, args.changelog)
            return 0
        except Exception as exc:
            for line in diagnostic({'domain': args.domain, 'base': Path('/srv/sites') / args.domain}, f'FAIL {exc}'):
                print_status(line, sys.stderr)
            return 1
    domains = [p.name for p in sorted(Path('/srv/sites').iterdir()) if (p / 'conf/wordpress-installed').exists()] if args.action == 'run' else [args.domain]
    failed = False
    for domain in domains:
        try:
            with operation_lock():
                failed = apply(site(domain), args) or failed
        except Exception as exc:
            for line in diagnostic({'domain': domain, 'base': Path('/srv/sites') / domain}, f'FAIL {domain}: {exc}'):
                print_status(line, sys.stderr)
            subprocess.run(['/usr/local/sbin/tg-alert', f'wp-update failed: {domain}; inspect logs'], check=False)
            failed = True
    return int(failed)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
